{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may listen for machine updates and call vKore's own bounded commands. It has no file, shell, network or window-management access; the agent's requests to its model are made by the app, never by the page.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-host-overview",
    "allow-machines-list",
    "allow-machine-get",
    "allow-machine-start",
    "allow-machine-stop",
    "allow-console-input",
    "allow-console-paste",
    "allow-console-resize",
    "allow-volume-open",
    "allow-volume-list",
    "allow-volume-preview",
    "allow-volume-close",
    "allow-hardware-get",
    "allow-hardware-check",
    "allow-hardware-save",
    "allow-agent-view",
    "allow-agent-enable",
    "allow-agent-disable",
    "allow-agent-send",
    "allow-agent-decide",
    "allow-agent-stop"
  ]
}
