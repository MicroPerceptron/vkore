@@ -0,0 +1,38 @@
+// Copyright (c) 2026 Cloudflare, Inc.
+// Licensed under the Apache 2.0 license found in the LICENSE file or at:
+// https://opensource.org/licenses/Apache-2.0
+
+//! Host-independent access to Kitesurf's document and rasterizer.
+
+use crate::{DomHandle, NodeData, paint::screenshot};
+pub use crate::resources::fonts::register_ua_fonts;
+
+impl DomHandle {
+    pub fn element_attribute(&self, node_id: u32, tag: Option<&str>, name: &str) -> Option<String> {
+        let id = self.resolve_node_id(node_id)?;
+        let doc = self.doc.borrow();
+        let NodeData::Element(element) = &doc.get_node(id)?.data else {
+            return None;
+        };
+        if tag.is_some_and(|tag| &*element.name.local != tag) {
+            return None;
+        }
+        element
+            .attrs
+            .iter()
+            .find(|attr| attr.prefix().is_none() && &*attr.name.local == name)
+            .map(|attr| attr.value.to_string())
+    }
+
+    pub fn paint_rgba(&self, width: u32, height: u32) -> Result<Vec<u8>, String> {
+        self.prepare_for_paint(width, height);
+        self.resolve_layout();
+        screenshot::paint_document_to_image(
+            self.doc.borrow_mut().as_mut(),
+            width,
+            height,
+            screenshot::ImageFormat::Rgba,
+            80,
+        )
+    }
+}
